---
/**
 * Slow-scrolling strip of member names — social proof under the hero.
 * CSS-only; pauses on hover; static (wrapped) under prefers-reduced-motion.
 */
import { getCollection } from 'astro:content';
const members = (await getCollection('members')).filter((m) => !m.data.draft);
// Deterministic shuffle so the strip looks varied but builds identically each time
const picked = members
  .map((m, i) => ({ m, k: (i * 9301 + 49297) % 233280 }))
  .sort((a, b) => a.k - b.k)
  .slice(0, 28)
  .map(({ m }) => ({ name: m.data.name, href: `/directory/${m.data.category.id}/${m.id}/` }));
const items = [...picked, ...picked]; // duplicated for a seamless loop
---
<section class="marquee" aria-label="Some of our member businesses">
  <p class="marquee__label small">Proud members include</p>
  <div class="marquee__track-wrap">
    <ul class="marquee__track">
      {items.map((it, i) => (
        <li aria-hidden={i >= picked.length ? 'true' : undefined}>
          <a href={it.href} tabindex={i >= picked.length ? -1 : undefined}>{it.name}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marquee { padding-block: var(--s-5); border-bottom: 1px solid var(--line); background: var(--paper); overflow: hidden; }
  .marquee__label { text-align: center; color: var(--ink-muted); letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; font-size: var(--fs-xs); margin-bottom: var(--s-3); }
  .marquee__track-wrap { mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee__track { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--s-6); width: max-content; }
  .marquee__track li { white-space: nowrap; font-family: var(--font-display); font-size: var(--fs-lg); color: var(--ink-soft); display: flex; align-items: center; gap: var(--s-6); }
  .marquee__track li::after { content: '·'; color: var(--terracotta); }
  .marquee__track a { color: inherit; text-decoration: none; transition: color var(--dur) var(--ease); }
  .marquee__track a:hover { color: var(--brick); }
  @media (prefers-reduced-motion: no-preference) {
    .marquee__track { animation: marquee 70s linear infinite; }
    .marquee:hover .marquee__track, .marquee:focus-within .marquee__track { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { flex-wrap: wrap; width: auto; justify-content: center; }
    .marquee__track li[aria-hidden] { display: none; }
    .marquee__track-wrap { mask-image: none; -webkit-mask-image: none; }
  }
</style>
