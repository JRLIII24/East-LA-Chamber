---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="container--narrow" style="text-align:center">
      <p class="eyebrow" style="justify-content:center">404</p>
      <h1>We couldn’t find that page.</h1>
      <p class="lede" style="margin-inline:auto">It may have moved during our site update. Try one of these, or search the member directory.</p>
      <ul class="grid grid--3" style="list-style:none;padding:0;margin:var(--s-7) 0">
        {nav.map((i) => <li><a class="card" href={i.href}><h3 style="margin:0">{i.label}</h3></a></li>)}
      </ul>
      <a href="/" class="btn btn--primary btn--lg">Back to home</a>
    </div>
  </section>
</Base>
