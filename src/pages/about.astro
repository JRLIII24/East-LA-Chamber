---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import civicPark from '../assets/brand/civic-park.jpg'; // PHOTO: about-1 — ELA Civic Center park (current site)
import hillside from '../assets/brand/hillside.jpg';   // PHOTO: about-2 — street scene (stock on current site; replace)

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const board = people.filter((p) => p.data.group === 'board');
const staff = people.filter((p) => p.data.group === 'staff');
const years = new Date().getFullYear() - site.founded;

const values = [
  { icon: 'users', title: 'Inclusivity', text: 'We welcome everyone and celebrate the diversity that strengthens our community.' },
  { icon: 'sparkles', title: 'Sustainability', text: 'Committed to eco-friendly practices for a greener, healthier future for generations to come.' },
  { icon: 'check', title: 'Safety', text: 'Ensuring a secure environment where residents and business owners feel safe and protected.' },
  { icon: 'arrow-up-right', title: 'Growth', text: 'Fostering development and innovation while preserving our community’s cherished traditions.' },
] as const;

// TODO(chamber): confirm milestones
const timeline = [
  { year: '1922', text: 'The East Los Angeles Chamber of Commerce is founded by local merchants.' },
  { year: '1968', text: 'TELACU is established — a long-standing chamber partner in economic development.' },
  { year: 'Today', text: `${years} years on, we represent businesses across unincorporated East LA and neighboring communities.` },
];
---
<Base title="About the East Los Angeles Chamber of Commerce" description={`Since ${site.founded}, the East Los Angeles Chamber of Commerce has advocated for local business and a vibrant economy. Learn about our mission, values, board and staff.`}>
  <PageHero eyebrow={`Est. ${site.founded}`} title="Discover the heart of our community" lede="Building connections, fostering growth and celebrating togetherness in East Los Angeles." crumbs={[{ label: 'About' }]} />

  <section class="about-photos">
    <Image src={civicPark} alt="The amphitheater and lake at East Los Angeles Civic Center park" widths={[640, 960, 1400]} sizes="(min-width: 48rem) 50vw, 100vw" class="about-photos__img" />
    <Image src={hillside} alt="A residential street in East Los Angeles with the hills behind" widths={[640, 960, 1400]} sizes="(min-width: 48rem) 50vw, 100vw" class="about-photos__img" />
  </section>

  <section class="section">
    <div class="container story">
      <div>
        <p class="eyebrow">Our story</p>
        <h2>A century of standing up for East LA business</h2>
      </div>
      <div class="prose flow">
        <p>The East Los Angeles Chamber of Commerce is committed to providing services designed to strengthen and promote our membership and business community.</p>
        <p>Our mission is to advance a strong business climate and vibrant economy by being an advocate for business and a catalyst for community and economic development in East Los Angeles, California.</p>
        <p>From family restaurants on Cesar Chavez Avenue to hospitals, banks and utilities that serve the whole region, our members share one thing: a stake in East LA's future. We connect them to each other, to local government and to the residents they serve.</p>
      </div>
    </div>
  </section>

  <section class="section band--night">
    <div class="container mv">
      <div class="card">
        <p class="eyebrow">Mission</p>
        <p class="mv__text">To advance a strong business climate and vibrant economy by being an advocate for business and a catalyst for community and economic development in East Los Angeles.</p>
      </div>
      <div class="card">
        <p class="eyebrow">Vision</p>
        <!-- TODO(chamber): confirm vision statement wording -->
        <p class="mv__text">An East Los Angeles where every business — large or small, new or generations old — has the connections, resources and voice it needs to thrive.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><p class="eyebrow">What we stand for</p><h2>Our values</h2></div>
      <ul class="grid grid--4 values" data-reveal data-stagger>
        {values.map((v) => (
          <li>
            <span class="values__icon"><Icon name={v.icon} size={22} /></span>
            <h3>{v.title}</h3>
            <p class="small">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head"><p class="eyebrow">History</p><h2>Milestones</h2></div>
      <ol class="timeline" data-reveal data-stagger>
        {timeline.map((t) => <li><span class="timeline__year">{t.year}</span><p>{t.text}</p></li>)}
      </ol>
    </div>
  </section>

  {(board.length > 0 || staff.length > 0) && (
    <section class="section">
      <div class="container">
        {board.length > 0 && (
          <>
            <div class="section-head"><p class="eyebrow">Leadership</p><h2>Board of directors</h2></div>
            <ul class="grid grid--4 people">
              {board.map((p) => (
                <li>
                  {p.data.photo ? <Image src={p.data.photo} alt={p.data.name} width={400} height={400} class="people__photo" /> : <span class="people__photo people__photo--empty">{p.data.name.split(' ').map((w) => w[0]).join('')}</span>}
                  <h3>{p.data.name}</h3>
                  <p class="small">{p.data.role}{p.data.organization && <><br /><span class="muted">{p.data.organization}</span></>}</p>
                </li>
              ))}
            </ul>
          </>
        )}
        {staff.length > 0 && (
          <>
            <div class="section-head" style="margin-top:var(--s-8)"><h2>Staff</h2></div>
            <ul class="grid grid--4 people">
              {staff.map((p) => (
                <li>
                  {p.data.photo ? <Image src={p.data.photo} alt={p.data.name} width={400} height={400} class="people__photo" /> : <span class="people__photo people__photo--empty">{p.data.name.split(' ').map((w) => w[0]).join('')}</span>}
                  <h3>{p.data.name}</h3>
                  <p class="small">{p.data.role}</p>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <section class="section band--brick">
    <div class="container" style="text-align:center">
      <h2>Be part of the next chapter.</h2>
      <p class="lede" style="margin-inline:auto;color:rgba(255,255,255,0.85)">Membership is open to businesses, non-profits and professionals who believe in East LA.</p>
      <p style="margin-top:var(--s-5)"><a href="/membership/" class="btn btn--primary btn--lg">Join the Chamber <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>
</Base>

<style>
  .about-photos { display: grid; grid-template-columns: 1fr 1fr; }
  .about-photos__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 48rem) { .about-photos__img { aspect-ratio: 16 / 9; } }
  .story { display: grid; gap: var(--s-6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 56rem) { .story { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); } }
  .mv { display: grid; gap: var(--s-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .mv .eyebrow { color: var(--terracotta-soft); }
  .mv__text { font-family: var(--font-display); font-size: var(--fs-xl); line-height: 1.3; color: var(--on-night); font-variation-settings: 'opsz' 72, 'SOFT' 50; }
  .values { list-style: none; margin: 0; padding: 0; }
  .values__icon { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radius); background: var(--blush); color: var(--brick); margin-bottom: var(--s-4); }
  .values h3 { font-size: var(--fs-lg); margin-bottom: var(--s-2); }
  .values p { color: var(--ink-soft); margin: 0; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); border-left: 2px solid var(--terracotta-soft); }
  .timeline li { position: relative; padding-left: var(--s-6); }
  .timeline li::before { content: ''; position: absolute; left: -7px; top: 0.5em; width: 12px; height: 12px; border-radius: 50%; background: var(--brick); }
  .timeline__year { font-family: var(--font-display); font-size: var(--fs-lg); color: var(--brick-deep); display: block; }
  .timeline p { margin: 0; color: var(--ink-soft); max-width: 60ch; }
  .people { list-style: none; margin: 0; padding: 0; }
  .people__photo { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-lg); margin-bottom: var(--s-3); }
  .people__photo--empty { display: grid; place-items: center; background: var(--paper-2); color: var(--brick); font-family: var(--font-display); font-size: 2rem; }
  .people h3 { font-size: var(--fs-lg); margin-bottom: var(--s-1); }
  .people p { margin: 0; }
</style>
