---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';

const sponsors = await getCollection('sponsors');
const tiers = [
  { key: 'presenting', title: 'Presenting sponsors', blurb: 'Our highest level of partnership — year-round visibility across the chamber’s events, website and communications.' },
  { key: 'gold', title: 'Gold sponsors', blurb: 'Event sponsors and major supporters of chamber programs.' },
  { key: 'community', title: 'Community sponsors', blurb: 'Businesses and organizations that help make our events and programs possible.' },
] as const;
---
<Base title="Sponsors & Sponsorship Opportunities" description="Thank you to the organizations sponsoring the East Los Angeles Chamber of Commerce. Learn about sponsorship tiers and benefits for your business.">
  <PageHero eyebrow="Sponsors" title="Partners investing in East LA" lede="Sponsorship funds our events, youth programs and community initiatives. We're grateful to every partner below." crumbs={[{ label: 'Sponsors' }]}>
    <div class="page-hero__actions"><a href="#become" class="btn btn--primary">Become a sponsor <Icon name="arrow-right" size={16} /></a></div>
  </PageHero>

  {tiers.map((t) => {
    const list = sponsors.filter((s) => s.data.tier === t.key);
    return list.length ? (
      <section class="section--tight section">
        <div class="container">
          <div class="section-head"><h2>{t.title}</h2><p class="lede">{t.blurb}</p></div>
          <ul class:list={['logo-wall', `logo-wall--${t.key}`]}>
            {list.map((s) => (
              <li>
                {s.data.url ? (
                  <a href={s.data.url} target="_blank" rel="noopener" title={s.data.name}><Image src={s.data.logo} alt={`${s.data.name} logo`} width={400} /></a>
                ) : s.data.member ? (
                  <a href={`/directory/?q=${encodeURIComponent(s.data.name)}`} title={s.data.name}><Image src={s.data.logo} alt={`${s.data.name} logo`} width={400} /></a>
                ) : (
                  <Image src={s.data.logo} alt={`${s.data.name} logo`} width={400} />
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null;
  })}

  <section class="section band--night" id="become">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Sponsorship</p><h2>Put your brand in front of East LA</h2><p class="lede">Sponsorship packages are flexible — from a single event to year-round presenting partnership. Every tier includes recognition on this page.</p></div>
      <!-- TODO(chamber): confirm tier names, pricing and benefits -->
      <div class="grid grid--3">
        <div class="card"><p class="tag" style="background:var(--gold);border-color:var(--gold);color:var(--night)">Presenting</p><h3>Year-round partner</h3><ul class="small"><li>Logo on homepage and every event</li><li>Speaking opportunity at Installation Dinner</li><li>Featured directory listing</li><li>Social media features</li></ul></div>
        <div class="card"><p class="tag">Gold</p><h3>Event sponsor</h3><ul class="small"><li>Logo on event materials and this page</li><li>Reserved table or booth</li><li>Recognition from the podium</li></ul></div>
        <div class="card"><p class="tag">Community</p><h3>Program supporter</h3><ul class="small"><li>Logo on this page</li><li>Recognition in the newsletter</li><li>Invitation to all chamber events</li></ul></div>
      </div>
      <p style="margin-top:var(--s-6)"><a href="/contact/?topic=sponsorship" class="btn btn--primary btn--lg">Ask about sponsorship <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>
</Base>

<style>
  .logo-wall { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .logo-wall--presenting { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .logo-wall li { display: grid; place-items: center; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s-5); aspect-ratio: 16 / 9; }
  .logo-wall a { display: contents; }
  .logo-wall img { max-height: 4.5rem; width: auto; max-width: 100%; object-fit: contain; }
  .band--night .card ul { padding-left: 1.2em; margin: var(--s-3) 0 0; color: var(--on-night-soft); }
  .band--night .card .tag { margin-bottom: var(--s-3); }
</style>
